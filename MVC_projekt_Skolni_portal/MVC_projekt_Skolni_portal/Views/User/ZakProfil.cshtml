@model MVC_projekt_Skolni_portal.Models.User;
@{
    ViewData["Title"] = "Profil žáka";
    ViewData["NadpisClass"] = "velky-nadpis";
}

<div class="sekce-profil-ucitele panel-sedy">
    <div class="profil-kontainer">
        <div class="profil-karta">
            <div class="profil-karta-vnitrni">
                <div class="profil-avatar">
                    <img src="~/obrazky/guest.png" alt="Avatar" />
                </div>
                <div class="profil-info">
                    <h2>@Model.Jmeno @Model.Prijmeni</h2>
                    <p class="radek-udaje"><strong>Třída:</strong>@Model.Trida</p>
                    <p class="radek-udaje"><strong>Adresa:</strong>@Model.Adresa</p>
                    <p class="radek-udaje"><strong>Školní e-mail:</strong>@Model.SkolniEmail</p>
                    <p class="radek-udaje"><strong>Telefon:</strong>@Model.Telefon</p>
                    <form action="/User/Odhlaseni" method="post">
                        <input type="submit" value="Odhlásit" />
                    </form>
                </div>
            </div>
        </div>

        <section class="teacher-tabs-section teacher-profile-tabs">
            <input class="teacher-tab-toggle" type="radio" id="tab-rozvrh" name="profil-tabs" checked />
            <input class="teacher-tab-toggle" type="radio" id="tab-tridy-znamky" name="profil-tabs" />

            <div class="teacher-tab-buttons">
                <label for="tab-rozvrh" class="teacher-tab-button">Rozvrh</label>
                <label for="tab-tridy-znamky" class="teacher-tab-button">Známky</label>
            </div>

            <div class="teacher-tab-panels">
                <section class="teacher-schedule-panel">
                    <h3 class="nadpis-sekce">Rozvrh žáka</h3>
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Dny \ Čas</th>
                                <th>8:00 - 8:45</th>
                                <th>8:55 - 9:40</th>
                                <th>9:50 - 10:35</th>
                                <th>10:45 - 11:30</th>
                                <th>11:40 - 12:25</th>
                                <th>12:35 - 13:20</th>
                                <th>13:20 - 14:05</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Pondělí</td><td>Matematika</td><td>Vývoj softwaru</td><td>-</td><td>IoT</td><td>Tělesná výchova</td><td>Anglický jazyk</td><td>-</td></tr>
                            <tr><td>Úterý</td><td>Počítačové sítě</td><td>Webové stránky</td><td>Matematika</td><td>Český jazyk</td><td>Fyzika</td><td>-</td><td>-</td></tr>
                            <tr><td>Středa</td><td>Mechatronika</td><td>Vývoj softwaru</td><td>Operační systémy</td><td>-</td><td>Anglický jazyk</td><td>Matematika</td><td>-</td></tr>
                            <tr><td>Čtvrtek</td><td>Matematika</td><td>Počítačové sítě</td><td>Webové stránky</td><td>Vývoj softwaru</td><td>Fyzika</td><td>-</td><td>-</td></tr>
                            <tr><td>Pátek</td><td>-</td><td>Matematika</td><td>IoT</td><td>Mechatronika</td><td>Český jazyk</td><td>-</td><td>-</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="teacher-grades-panel">
                    <h3 class="nadpis-sekce">Znamky</h3>

                    @* KONTROLA: Máme v ViewBag nějaké známky? *@
                    @if (ViewBag.PosledniZnamky != null && ((List<MVC_projekt_Skolni_portal.Models.Grade>)ViewBag.PosledniZnamky).Count > 0)
                    {
                        <table class="schedule-table">
                            <thead>
                                <tr>
                                    <th>Typ hodnocení (Popis)</th>
                                    <th style="text-align: center;">Známka</th>
                                    <th style="text-align: center;">Váha</th>                                  
                                    <th>Datum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* CYKLUS: Projdeme všechny načtené známky z C# *@
                                @foreach (var znamka in (List<MVC_projekt_Skolni_portal.Models.Grade>)ViewBag.PosledniZnamky)
                                {
                                    <tr>
                                        @* 1. Sloupec: Popis / téma písemky (Description) *@
                                        <td>
                                            @(string.IsNullOrEmpty(znamka.Description) ? "Bez popisu" : znamka.Description)
                                        </td>

                                        @* 2. Sloupec: Hodnota známky (Value) *@
                                        <td style="text-align: center;">
                                            <strong style="font-size: 1.1em; color: #0d47a1;">@znamka.Value</strong>
                                        </td>

                                        @* 3. Sloupec: Váha známky (Weight) *@
                                        <td style="text-align: center; color: #666; font-weight: bold;">@znamka.Weight</td>

                                        @* 4. Sloupec: Datum zápisu (DateCreated). Zformátujeme ho pro pěkné čtení *@
                                        <td style="text-align: center;">@znamka.DateCreated.ToString("dd. MM. yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        @* Zobrazí se pouze, pokud žák ještě v DB žádnou známku nemá *@
                        <p style="color: #666; font-style: italic; padding: 15px;">Zatím nemáš zapsané žádné známky.</p>
                    }
                </section>
            </div>
        </section>
    </div>
</div>