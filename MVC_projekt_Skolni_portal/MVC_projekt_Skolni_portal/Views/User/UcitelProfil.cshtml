@{
    ViewData["Title"] = "Profil učitele";
    ViewData["NadpisClass"] = "velky-nadpis"; // použije se v _Layout.cshtml
}

<div class="sekce-profil-ucitele panel-sedy">
    <div class="profil-kontainer">
        <div class="profil-karta">
            <div class="profil-karta-vnitrni">
                <div class="profil-avatar">
                    <img src="~/obrazky/guest.png" alt="Avatar" class="profil-avatar-img" />
                </div>
                <div class="profil-info">
                    <h2>Jméno Příjmení</h2>
                    <p class="radek-udaje"><strong>Předmět:</strong> Matematika</p>
                    <p class="radek-udaje"><strong>Adresa:</strong> Ulice 123, Město</p>
                    <p class="radek-udaje"><strong>Školní e-mail:</strong> ucitel@skola.cz</p>
                    <p class="radek-udaje"><strong>Telefon:</strong> +420 123 456 789</p>
                </div>
            </div>
        </div>
    <!-- Akční tlačítka pod kartou profilu; stejná šířka jako bílá karta -->
    <div class="profil-akce">
        <button type="button" class="profil-tlacitko primarni">Upravit profil</button>
        <button type="button" class="profil-tlacitko vedlejsi">Nastavení</button>
    </div>
    </div>
</div>
